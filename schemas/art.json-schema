{
  "type": "object",
  "properties": {
    "art_instructions": {
      "type": "string",
      "description": "3-10 sentence instructions for an artist to render an image that goes with the text (instructions should include enough details that two different artists will draw the same picture; in particular the instructions must include information about each character and object's placement/size/pose/emotion/action/etc),"
    },
    "art_characters": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "This is the list of characters that appear in art_instructions. Each entry must exactly match the name of a character (including capitalization and any diacritics)"
      }
    },
    "shot_type": {
      "type": "string",
      "enum": [
        "extreme_wide_shot",
        "wide_shot",
        "medium_shot",
        "close_up",
        "extreme_close_up"
      ]
    },
    "camera_angle": {
      "type": "string",
      "enum": [
        "eye_level",
        "high_angle",
        "low_angle",
        "birds_eye_view",
        "worms_eye_view"
      ]
    }
  },
  "required": [
    "art_instructions",
    "art_characters",
    "shot_type",
    "camera_angle"
  ]
}

