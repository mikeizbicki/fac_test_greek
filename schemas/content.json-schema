{
  "type": "object",
  "description": "A complete description for a story to teach children Koine Greek.  Downstream tasks will use this information to generate a book and an animation from this story. Downstream tasks may have access to only parts of this JSON object, and so instructions about including/excluding information in sub-objects must be carefully followed for the downstream tasks to succeed.",
  "properties": {
    "title": {
      "type": "string",
      "description": "A 1-5 word title for the story in Koine Greek"
    },
    "learning_goal": {
      "type": "string",
      "description": "A 1 sentence English description of the vocabulary/grammar concepts this story will emphasize.  Other vocab/grammar is allowed to make the story flow, but the vocab/grammar specified here will be repeated over and over."
    },
    "plot": {
      "type": "string",
      "description": "A 1 sentence English description of the story's plot."
    },
    "frames": {
      "type": "array",
      "description": "Each frame represents a single page in a children's book, a single frame in a comic book, or a single beat from a movie.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The text for this frame of the story. Each frame should contain at most 20 words. If more text is needed, it should be broken up into multiple frames. This text should exactly match the dialogue from the fountain script. Do not include quotation marks or guillemets unless the original script contains them. "
          },
          "speaker": {
            "type": "string",
            "description": "The character that is speaking the text."
          },
          "frame_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$",
            "description": "1-5 words that uniquely identify the frame."
          },
          "characters": {
            "type": "array",
            "description": "The list of characters involved in this frame. May be empty.",
            "items": {
              "type": "string",
              "description": "Must exactly match the name of a character."
            }
          },
          "locations": {
            "type": "array",
            "description": "The list of locations that the scene takes place in.  Normally only a single location will be listed.  Multiple locations will be listed for 'transition scenes' between those locations.  The array will be empty if there are no relevant locations from the 'locations/' folder and the artist should make up a new location.",
            "items": {
              "type": "string",
              "description": "Must exactly match the name of a location."
            }
          },
          "objects": {
            "type": "array",
            "description": "Any important objects/landmarks/figures/etc that are not described in the location/characters files must be inserted in this array.  Example objects include: ball, tree, fence, couch, table, statue. If the objects will be used in a future frame at the same location, they must be present in the current frame even if they are not used in the current frame. Do not include objects that will not be used in the storyline. The list should include everything that characters might interact with, but nothing that is not strictly necessary.",
            "items": {
              "type": "string",
              "description": "A one sentence description of what the object looks like.  The description should include color/shape/texture/size and other information as appropriate for the object. If the object appears in multiple frames, the frames must have the exact same description of the object."
            }
          },
          "positioning": {
            "type": "array",
            "description": "Every object/character should have an entry.",
            "items": {
              "type": "string",
              "description": "A one sentence description of where the object/character should be drawn in the picture.  The positioning should be consistent between frames so that if CHAR1 was running towards OBJECT in the previous frame, in the next frame CHAR1 might be holding OBJECT. You must specify where every character is looking at whether we have a front/side/back/three-quarter/etc view."
            }
          },
          "motivations": {
            "type": "array",
            "description": "Every character should have an entry.",
            "items": {
              "type": "string",
              "description": "1 sentence describing what has previously happened to the character (or what will happen) that explains why they are feeling the way they are. These motivations are used to ensure consistent art between frames, and so any information that could help build consistency should be included here. You must be specific about WHY and WITH WHOM the characters are feeling emotions. The artist will not have access to the previous frames and will have to rely in this motivations section to draw this frame consistently with the previous/next frames."
            }
          },
          "artist_notes": {
            "type": "string",
            "description": "A 1-3 sentence description of custom drawing instructions that are not captured by the other fields. It is okay to leave this blank."
          },
          "reference_frame": {
            "type": "string",
            "description": "When provided, this value must exactly match the frame_id of a previous frame. This value should only be provided if this frame will be in a continuous 'shot' with the previous frame during the final animation. If the location of the two frames is the same, then this fields should probably be provided, and if the location is different, then this field should probably not be provided."
          },
          "camera": {
            "type": "string",
            "description": "1-3 sentence description of what the camera should be focusing on/how the camera is moving/what type of shot we see (wide/head shot/etc)."
          }
        },
        "required": [
          "text",
          "frame_id",
          "characters",
          "locations",
          "objects",
          "positioning",
          "motivations"
        ]
      }
    }
  },
  "required": [
    "title",
    "frames",
    "plot",
    "learning_goal"
  ]
}
