{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^\\S+$",
      "description": "should match the path of the file"
    },
    "description": {
      "type": "string",
      "description": "3-5 word phrase that describes the character"
    },
    "sex": {
      "type": "string",
      "enum": ["male", "female"]
    },
    "height_in_meters": {
      "type": "number",
      "description": "height in meters"
    },
    "appearance": {
      "type": "string",
      "description": "2-5 sentences; provide concrete details that would allow an artist to reproduce a portrait of the character"
    },
    "dnd_alignment_axes": {
      "type": "string",
      "description": "should be a dungeons and dragons alignment like lawful-good, neutral-evil, chaotic-neutral, etc."
    }
  },
  "required": ["name", "description", "sex", "appearance", "height_in_meters", "alignment"]
}
