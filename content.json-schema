{
  "type": "object",
  "properties": {
    "text_koine": {
      "type": "string",
      "description": "The text for this frame of the story in Koine greek."
    },
    "text_english": {
      "type": "string",
      "description": "A literal translation of the Koine into English."
    },
    "frame_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]+$",
      "description": "1-5 words that uniquely identify the frame."
    },
    "characters": {
      "type": "array",
      "description": "The list of characters involved in this frame. May be empty.",
      "items": {
        "type": "string",
        "description": "Must exactly match the name of a character."
      }
    },
    "locations": {
      "type": "array",
      "description": "The list of locations that the scene takes place in.  Normally only a single location will be listed.  Multiple locations will be listed for 'transition scenes' between those locations.  The array will be empty if there are no relevant locations from the 'locations/' folder and the artist should make up a new location.",
      "items": {
        "type": "string",
        "description": "Must exactly match the name of a location."
      }
    },
    "objects": {
      "type": "array",
      "description": "Any important objects that are not described in the location/characters files must be inserted in this array.",
      "items": {
        "type": "string",
        "description": "A one sentence description of what the object looks like.  The description should include color/shape/texture/size and other information as appropriate for the object. If the object appears in multiple frames, the frames must have the exact same object_notes."
      }
    },
    "positioning": {
      "type": "array",
      "description": "Every object/character should have an entry.",
      "items": {
        "type": "string",
        "description": "A one sentence description of where the object/character should be drawn in the picture.  The positioning should be consistent between frames so that if CHAR1 was running towards OBJECT in the previous frame, in the next frame CHAR1 might be holding OBJECT."
      }
    }
  },
  "required": [
    "text_koine",
    "text_english",
    "frame_id",
    "characters",
    "locations",
    "objects",
    "positioning"
  ]
}
